# Cloudflare R2 Credentials (from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=stories

# Optional: custom domain or public R2 URL (e.g., cdn.yourdomain.com or pub-xxx.r2.dev)
R2_PUBLIC_DOMAIN=

# Optional settings
PORT=3000
PART_SIZE=52428800
URL_EXPIRY=7200
